{
  "name": "car-dealership-backend",
  "version": "1.0.0",
  "description": "RESTful API for Car Dealership Inventory System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --detectOpenHandles --runInBand --forceExit",
    "test:coverage": "jest --coverage --detectOpenHandles --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "keywords": ["car-dealership", "inventory", "api", "typescript", "express"],
  "author": "Car Dealership Dev",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/sqlite3": "^3.1.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
